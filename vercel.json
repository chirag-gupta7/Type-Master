{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build:frontend",
  "outputDirectory": "apps/frontend/.next",
  "env": {
    "NEXT_PUBLIC_API_URL": "@typemaster_api_url",
    "NEXTAUTH_SECRET": "@typemaster_nextauth_secret",
    "NEXTAUTH_URL": "@typemaster_nextauth_url",
    "GOOGLE_CLIENT_ID": "@typemaster_google_client_id",
    "GOOGLE_CLIENT_SECRET": "@typemaster_google_client_secret",
    "INTERNAL_API_SECRET": "@typemaster_internal_api_secret",
    "DATABASE_URL": "@typemaster_database_url"
  }
}
