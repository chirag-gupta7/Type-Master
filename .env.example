# Copy to `.env.local` (frontend, repo root) or set these in your Vercel project.
# All values marked `@name` are referenced from vercel.json as Vercel project
# environment variables — configure them once in the Vercel dashboard.

# Backend API (Express + Prisma on Render). Used by the Next rewrites and apiBase.ts.
NEXT_PUBLIC_API_URL=https://typemaster-backend-pfns.onrender.com

# NextAuth (frontend uses a Prisma adapter, so it also needs DATABASE_URL).
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=https://typemaster-chirag.vercel.app

# Google OAuth (optional; credentials provider works without these).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared secret used by the frontend -> backend token bridge (INTERNAL_API_SECRET).
INTERNAL_API_SECRET=replace-with-the-same-secret-as-the-backend

# PostgreSQL connection string used by the NextAuth Prisma adapter.
DATABASE_URL=postgresql://user:password@host:5432/typemaster
